import React, { ReactNode } from "react";
import { graphql } from "gatsby";
import { CompanyData } from "../interfaces/interfaces";
import LatinClubLayout from "./latinClubLayout";
import MainLogo from "../components/mainLogo";
import { useTranslation } from "react-i18next";
import images from "../images";
import Footer from "../components/footer";
import data from "../data/data.json";
import { Helmet } from "react-helmet";
import favicon from "../images/icon.png";

interface eventsClubProps {
  children: ReactNode;
  data?: CompanyData;
  eventPage?: boolean;
}

const companyInfo: CompanyData = data[0];

const eventsClub: React.FC<eventsClubProps> = () => {
  const { t } = useTranslation();
  return (
    <div
      className="flex flex-col w-full h-full"
      style={{
        backgroundImage: `url(${images.BackgroundTexture.src})`,
        backgroundSize: "content",
      }}
    >
      <LatinClubLayout data={companyInfo} showNavigation={true}>

      <Helmet>
        <title>{`${t("menuDrink.eventsClub")} - ${companyInfo.name}`}</title>
        <link rel="icon" href={favicon} />
      </Helmet>

            {/* 🗓 Eventos */}
            <div className="w-4/5 mx-auto my-20">
        <h2 className="text-3xl text-center text-latinFucsia font-bold mb-10">
          {t("events.title")}
        </h2>
        <div className="flex flex-col gap-10">
          {companyInfo.events?.map((event, index) => {
            const imageKey = t(`events.${event.image}`);
            const imageData = images[imageKey as keyof typeof images];

            return (
              <div
                key={index}
                className="flex flex-col md:flex-row bg-white bg-opacity-10 backdrop-blur-md border border-white border-opacity-20 rounded-xl shadow-lg text-white overflow-hidden"
              >
                <div className="md:w-1/2">
                  <img
                    src={imageData?.src}
                    alt={imageData?.alt || ""}
                    className="w-full h-64 md:h-full object-cover"
                  />
                </div>

                <div className="p-6 flex flex-col justify-center md:w-1/2">
                  <h3 className="text-2xl font-semibold mb-2  text-latinFucsia">
                    {t(`events.${event.name}`)}
                  </h3>
                  <p className="text-sm text-gray-200 mb-1">
                    {t(`events.${event.date}`)}
                  </p>
                  <p
                    className="mt-2"
                    dangerouslySetInnerHTML={{
                      __html: t(`events.${event.description}`) || "",
                    }}
                  ></p>
                </div>
              </div>
            );
          })}
        </div>
      </div>

        <div className="w-[20rem] mx-auto">
          <a href="/">
            <MainLogo fillColour={"#fff"} />
          </a>
        </div>
        <h3 className="text-primary text-5xl text-center my-8 w-full tracking-widest">
          {t("general.eventsClubPage.title")}
        </h3>

        <div className="flex flex-col sm:flex-row max-w-[920px] mx-auto ">
          <div className="flex  w-full sm:w-1/2 p-16 relative">
            <img
              src={images.planta_7.src}
              className="absolute w-20 sm:w-44 right-0 top-0"
              alt={images.planta_7.alt}
            />

            <div
              className={`${styles.before} before:w-[372px] before:h-[510px] before:left-4 before:top-12`}
            >
              <img
                className="w-full sm:w-[332px] h-auto sm:h-[470px]"
                src={images.events_1.src}
                alt={images.events_1.alt}
              />
            </div>
            <img
              src={images.planta_7.src}
              className="absolute w-20 sm:w-44 rotate-180 left-0 bottom-0"
              alt={images.planta_7.alt}
            />
          </div>
          <div className="flex flex-col w-full sm:w-1/2 pl-8 pr-8 sm:pr-0 pt-24">
            <h4 className="text-latinFucsia text-2xl text-right">
              {t("general.eventsClubPage.subtitle")}
            </h4>
            <p className="text-white text-xl text-right pt-8">
              {t("general.eventsClubPage.content_1")}
            </p>
          </div>
        </div>

        <div className="flex sm:flex-row max-w-[920px] mx-auto relative flex-col-reverse">
            <div className="flex flex-col self-center">
              <p className="text-white text-xl px-8 sm:px-0">
                {t("general.eventsClubPage.content_2")}
              </p>
            </div>
            <div className="flex relative z-20">
              <div
                className={`${styles.before} before:w-[406px] before:h-[312px] before:-left-4 before:-top-4`}
              >
                <img
                  className="p-8 sm:p-0"
                  src={images.events_2.src}
                  alt={images.events_2.alt}
                />
              </div>
            </div>
          <img
            src={images.planta_7.src}
            className="absolute w-20 sm:w-44 rotate-45 right-8 sm:-right-12 -bottom-24 z-10"
            alt={images.planta_7.alt}
          />
        </div>

        <div className="flex relative h-64 mt-24">
          <div className="flex flex-row w-full overflow-hidden relative">
            <img
              className="w-1/2 -scale-x-100 object-cover aspect-[4/3] absolute top-0"
              src={images.plantasFlamingo.src}
              alt={images.plantasFlamingo.alt}
            />
            <img
              className="w-1/2 object-cover aspect-[4/3] absolute top-0 right-0"
              src={images.plantasFlamingo.src}
              alt={images.plantasFlamingo.alt}
            />
          </div>
        </div>

        <div className="bg-latinClub">
          <Footer isLatinClub={true} data={companyInfo} />
        </div>
      </LatinClubLayout>
    </div>
  );
};

export default eventsClub;

export const query = graphql`
  query ($language: String!) {
    locales: allLocale(filter: { language: { eq: $language } }) {
      edges {
        node {
          ns
          data
          language
        }
      }
    }
  }
`;

const styles = {
  before:
    "before:sm:content-[''] before:content-[] before:block before:border-latinFucsialight before:border-2 before:rounded-2xl before:absolute before:shadow-md before:shadow-latinFucsia",
};
