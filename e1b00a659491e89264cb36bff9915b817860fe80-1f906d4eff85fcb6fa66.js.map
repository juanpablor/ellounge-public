import React from "react";
import { Helmet } from "react-helmet";
import type { SEOProps } from "../interfaces/interfaces";

const DEFAULT_OG_IMAGE = "https://ellounge.ca/logo.png";

function stripTrailingSlash(url: string) {
  return url.replace(/\/+$/, "");
}

function ensureLeadingSlash(path: string) {
  if (!path) return "/";
  return path.startsWith("/") ? path : `/${path}`;
}

function stripQueryAndHash(path: string) {
  return path.split("?")[0].split("#")[0];
}

function ensureTrailingSlash(path: string) {
  if (!path) return "/";
  return path.endsWith("/") ? path : `${path}/`;
}

function isAbsoluteUrl(url?: string) {
  return !!url && /^https?:\/\//i.test(url);
}

const SEO: React.FC<SEOProps> = ({
  data,
  titleKey,
  descriptionKey,
  title,
  description,
  language,
  languages,
  defaultLanguage,
  originalPath,
  pathname,
  canonical,
  image,
  noindex,
  schemaType = "LocalBusiness",
  schemaName,
  additionalSchemas,
}) => {
  const resolvedTitle =
    title ?? titleKey ?? "El Lounge - Authentic Latin Cuisine in Montreal";

  const resolvedDescription =
    description ?? descriptionKey ?? "El Lounge - Authentic Latin Cuisine in Montreal";

  const currentLanguage = language || defaultLanguage || "en";
  const currentDefaultLanguage = defaultLanguage || currentLanguage;
  const availableLanguages = languages || [currentDefaultLanguage];

  const siteUrl = stripTrailingSlash((data.url || "").trim());

  const baseOriginalPath = ensureTrailingSlash(
    stripQueryAndHash(ensureLeadingSlash(originalPath || pathname || "/"))
  );

  const autoLocalizedPath =
    currentLanguage === currentDefaultLanguage
      ? baseOriginalPath
      : ensureTrailingSlash(`/${currentLanguage}${baseOriginalPath}`);

  const finalPath = ensureTrailingSlash(
    stripQueryAndHash(ensureLeadingSlash(pathname ?? autoLocalizedPath))
  );

  const resolvedCanonical =
    canonical ?? (siteUrl ? `${siteUrl}${finalPath}` : undefined);

  const ogImage = isAbsoluteUrl(image)
    ? image
    : image && siteUrl
      ? `${siteUrl}${ensureLeadingSlash(image)}`
      : DEFAULT_OG_IMAGE;

  const hrefLangLinks =
    siteUrl && availableLanguages.length
      ? availableLanguages.map((lng: string) => {
          const hrefPath =
            lng === currentDefaultLanguage
              ? baseOriginalPath
              : ensureTrailingSlash(`/${lng}${baseOriginalPath}`);

          return (
            <link
              key={lng}
              rel="alternate"
              hrefLang={lng}
              href={`${siteUrl}${hrefPath}`}
            />
          );
        })
      : null;

  const xDefaultHref =
    siteUrl && currentDefaultLanguage
      ? `${siteUrl}${baseOriginalPath}`
      : undefined;

  const schemaMarkup = {
    "@context": "https://schema.org",
    "@type": schemaType,
    name: schemaName || "El Lounge - Authentic Latin Cuisine in Montreal",
    image: ogImage,
    address: {
      "@type": "PostalAddress",
      streetAddress: data.address,
      addressLocality: data.city,
      addressRegion: data.province,
      postalCode: data.postalCode,
      addressCountry: data.country === "Canada" ? "CA" : data.country,
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: 45.35475,
      longitude: -73.7376551,
    },
    url: resolvedCanonical,
    telephone: data.phone,
    priceRange: "$$",
    openingHours: "Mo-Fr 09:00-17:00",
    sameAs: [data.instagram, data.facebook].filter(Boolean),
  };

  const extras = Array.isArray(additionalSchemas)
    ? additionalSchemas
    : additionalSchemas
      ? [additionalSchemas]
      : [];


      
  return (
    <Helmet>
      <html lang={currentLanguage} />
      <title>{resolvedTitle}</title>
      <meta name="description" content={resolvedDescription} />

      {resolvedCanonical && <link rel="canonical" href={resolvedCanonical} />}
      {hrefLangLinks}
      {xDefaultHref && <link rel="alternate" hrefLang="x-default" href={xDefaultHref} />}

      {noindex && <meta name="robots" content="noindex, nofollow" />}

      <meta property="og:type" content="website" />
      <meta property="og:title" content={resolvedTitle} />
      <meta property="og:description" content={resolvedDescription} />
      {resolvedCanonical && <meta property="og:url" content={resolvedCanonical} />}
      {ogImage && <meta property="og:image" content={ogImage} />}

      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={resolvedTitle} />
      <meta name="twitter:description" content={resolvedDescription} />
      {ogImage && <meta name="twitter:image" content={ogImage} />}

      <script type="application/ld+json">{JSON.stringify(schemaMarkup)}</script>

      {extras.map((schema, idx) => (
        <script key={idx} type="application/ld+json">
          {JSON.stringify(schema)}
        </script>
      ))}
    </Helmet>
  );
};

export default SEO;
