import React, { useState } from "react";
import {
  collection,
  addDoc,
  serverTimestamp,
  Firestore,
} from "firebase/firestore";
import { Box, Button, TextField } from "@mui/material";
import { useTranslation, useI18next } from "gatsby-plugin-react-i18next";
import { getFirestore } from "firebase/firestore";
import { app } from "../../src/firebaseConfig";
import MainLogo from "./mainLogo";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import { LocalizationProvider } from "@mui/x-date-pickers/LocalizationProvider";
import { DatePicker } from "@mui/x-date-pickers/DatePicker";
import dayjs from "dayjs";
import emailjs from "@emailjs/browser";


let db: Firestore | null = null;

if (typeof window !== "undefined") {
  db = getFirestore(app);
}

type ErrorState = {
  email: string;
  phone: string;
  general: string;
  birthDate: Date | null;
};

const ContactForm = () => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({
    fullName: "",
    email: "",
    phone: "",
    birthDate: null as Date | null, // Aquí cambiamos a Date | null
  });

  const [error, setError] = useState<ErrorState>({
    email: "",
    phone: "",
    general: "",
    birthDate: null,
  });

  const [isSubmitted, setIsSubmitted] = useState(false);

  const validateEmail = (email: string) =>
    /^[\w-.]+@([\w-]+\.)+[\w-]{2,4}$/.test(email);
  const validatePhone = (phone: string) => /^\+?\d{10,15}$/.test(phone);

  const handleInputChange = (
    e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>
  ) => {
    const { name, value } = e.target;
    setFormData({ ...formData, [name]: value });
    setError((prevError) => ({ ...prevError, [name]: "" }));
  };

  const { language } = useI18next();

const handleSubmit = async (e: React.FormEvent) => {
  e.preventDefault();

  // Validación
  let isValid = true;
  const newError: ErrorState = {
    email: "",
    phone: "",
    general: "",
    birthDate: null,
  };

  if (!validateEmail(formData.email)) {
    newError.email = t("form.emailError");
    isValid = false;
  }
  if (!validatePhone(formData.phone)) {
    newError.phone = t("form.phoneError");
    isValid = false;
  }
  if (!isValid) {
    setError(newError);
    return;
  }

  setError({ email: "", phone: "", general: "", birthDate: null });

  try {
    if (db) {
      await addDoc(collection(db, "contactForm"), {
        ...formData,
        birthDate: formData.birthDate
          ? dayjs(formData.birthDate).format("MMMM-DD")
          : null,
        timestamp: serverTimestamp(),
        role: "user",
        language,
      });
    }

  
    await emailjs.send(
      "service_x6dgiw7", // service ID
      "template_i83dntk", // template ID
      {
        fullName: formData.fullName,
        email: formData.email,
        phone: formData.phone,
        birthDate: formData.birthDate
          ? dayjs(formData.birthDate).format("MMMM-DD")
          : "",
        language,
        subject: t("email.subject"),
        h1: t("email.message.h1"),
        h3_1: t("email.message.h3_1"),
        p_1: t("email.message.p_1"),
        p_2: t("email.message.p_2"),
        p_3: t("email.message.p_3"),
        p_4: t("email.message.p_4"),
        p_5: t("email.message.p_5"),
        h3_2: t("email.message.h3_2"),
        
      },
      "mF_DgvHzKjt2tKkrM" // public key de EmailJS
    );

    setFormData({ fullName: "", email: "", phone: "", birthDate: null });
    setIsSubmitted(true);
  } catch (error) {
    setError((prevError) => ({
      ...prevError,
      general: t("form.generalError"),
    }));

  }
};


  return (
    <div className={styles.container}>
      {isSubmitted ? (
        <div className="flex flex-col items-center mt-6">
          <div className={styles.thankYouMessage}>
            {t("form.thankYouMessage")}
          </div>
          <div className="my-24">
            <MainLogo fillColour="#ccc" />
          </div>
        </div>
      ) : (
        <>
          <Box
            component="form"
            sx={{ "& > :not(style)": { mt: 4, width: "100%" } }}
            noValidate
            autoComplete="off"
            onSubmit={handleSubmit}
            className={styles.form}
          >
            {error.general && (
              <p className={styles.errorMessage}>{error.general}</p>
            )}
            <TextField
              id="name"
              label={t("form.name")}
              variant="standard"
              className="text-white"
              sx={{
                "& .MuiInput-underline:before": {
                  borderBottomColor: "#eb11ff",
                },
                "& .MuiInput-underline:after": { borderBottomColor: "#03f0ff" },
                "& .MuiInputBase-input": { color: "#999999" },
                "& .MuiFormLabel-root": { color: "#eb11ff" },
                "& .MuiFormLabel-root.Mui-focused": { color: "#03f0ff" },
              }}
              name="fullName"
              value={formData.fullName}
              onChange={handleInputChange}
              required
            />
            <TextField
              id="email"
              label={t("form.email")}
              variant="standard"
              sx={{
                "& .MuiInput-underline:before": {
                  borderBottomColor: "#eb11ff",
                },
                "& .MuiInput-underline:after": { borderBottomColor: "#03f0ff" },
                "& .MuiInputBase-input": { color: "#999999" },
                "& .MuiFormLabel-root": { color: "#eb11ff" },
                "& .MuiFormLabel-root.Mui-focused": { color: "#03f0ff" },
              }}
              type="email"
              name="email"
              value={formData.email}
              onChange={handleInputChange}
              required
            />
            {error.email && (
              <p className={styles.errorMessage}>{error.email}</p>
            )}
            <TextField
              id="phone"
              label={t("form.phone")}
              variant="standard"
              sx={{
                "& .MuiInput-underline:before": {
                  borderBottomColor: "#eb11ff",
                },
                "& .MuiInput-underline:after": { borderBottomColor: "#03f0ff" },
                "& .MuiInputBase-input": { color: "#999999" },
                "& .MuiFormLabel-root": { color: "#eb11ff" },
                "& .MuiFormLabel-root.Mui-focused": { color: "#03f0ff" },
              }}
              type="tel"
              name="phone"
              value={formData.phone}
              onChange={handleInputChange}
              required
            />
            {error.phone && (
              <p className={styles.errorMessage}>{error.phone}</p>
            )}

            <LocalizationProvider dateAdapter={AdapterDayjs}>
              <DatePicker
                label={t("form.birthDate")}
                views={["month", "day"]}
                format="MMMM/DD"
                onChange={(newValue) => {
                  // Aquí aseguramos que birthDate se actualice correctamente
                  setFormData((prevFormData) => ({
                    ...prevFormData,
                    birthDate: newValue ? newValue.toDate() : null, // Guardamos la fecha como un objeto Date
                  }));
                }}
                sx={{
                  "& .MuiFormLabel-root": {
                    color: "#eb11ff",
                  },
                  "& .MuiInput-underline:after": {
                    color: "#03f0ff",
                  },
                  "& .MuiFilledInput-root": {
                    backgroundColor: "transparent",
                  },
                  "& .MuiFilledInput-root:before": {
                    borderBottomColor: "#eb11ff",
                  },
                  "& .MuiInputBase-input": { color: "#999999" },
                }}
                slotProps={{
                  openPickerIcon: { fontSize: "large" },
                  openPickerButton: { color: "secondary" },
                  textField: {
                    variant: "filled",
                    focused: false,
                    color: "secondary",
                  },
                }}
                value={formData.birthDate ? dayjs(formData.birthDate) : null} // Asegúrate de que el valor sea un objeto dayjs
              />
            </LocalizationProvider>

            <div className="mt-16 w-full">
              <Button
                type="submit"
                variant="contained"
                className="capitalize !bg-latinFucsia 1mt-16 w-full"
              >
                {t("form.button")}
              </Button>
            </div>
          </Box>
        </>
      )}
    </div>
  );
};

export default ContactForm;

const styles = {
  container: "flex flex-col w-4/5 sm:w-3/5 text-darkGray/70 justify-center mx-auto",
  form: "flex flex-col w-full px-2 sm:px-12",
  errorMessage: "text-red-600 text-xs",
  thankYouMessage: "text-latinBlue text-4xl text-center",
  logo: "w-36 mx-auto mt-6",
};
