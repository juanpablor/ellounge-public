import React, { useRef } from "react";
import Slider from "react-slick";
import "slick-carousel/slick/slick.css";
import "slick-carousel/slick/slick-theme.css";

interface CarouselProps {
    images: { src: string; alt?: string }[];
    speed?: number;
    textOverlay?: {content: string; positionClass?: string}[];
    classText?: string;
  }
  
  const Carousel: React.FC<CarouselProps> = ({ images, textOverlay = [], classText }) => {
    const sliderRef = useRef<Slider | null>(null);

  const settings = {
    dots: true,
    autoplay: true,
    infinite: true,
    arrows: true,
    
    className: "center",
    slidesToShow: 1,
    speed: 1200,

    slidesToScroll: 1,
    vertical: true,
    verticalSwiping: true,
  };

  const handleMouseEnter = () => {
    if(sliderRef.current) {
        sliderRef.current.slickPause();
    }
};
const handleMouseLeave = () => {
      if(sliderRef.current) {
          sliderRef.current.slickPlay();
      }
  };

  return (
    <div className={styles.carouselContainer} onMouseEnter={handleMouseEnter} onMouseLeave={handleMouseLeave}>
      <Slider {...settings} ref={sliderRef}>
        {images.map((image, index) => (
          <div key={index} className="relative -mb-2">
            <img src={image.src} alt={image.alt || `Slide ${index + 1}`} className={styles.carouselImage} />
            {textOverlay[index]?.content && (
              <div
                className={`${styles.carouselText} ${textOverlay[index].positionClass || ""} ${classText || ""}`}
              >
                {textOverlay[index].content}
              </div>
            )}
          </div>
        ))}
      </Slider>
    </div>
  );
};

export default Carousel;

const styles = {
    carouselContainer: "w-full  mx-auto relative rounded-lg shadow overflow-hidden sm:overflow-visible",
    carouselImage: " sm:h-auto  object-cover rounded-lg",
    carouselText: "absolute text-white sm:text-light text-xl sm:text-3xl font-bold dm_sans_bold text_shadow bottom-0 p-4"
}