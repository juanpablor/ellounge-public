import "./src/styles/global.css";

function updateGAConsent(granted) {
  if (typeof window.gtag === "function") {
    window.gtag("consent", "update", {
      analytics_storage: granted ? "granted" : "denied",
    });
  }
}

function getKlaroConsent() {
  try {
    const match = document.cookie.match(/(?:^|;\s*)klaro=([^;]*)/);
    if (!match) return null;
    return JSON.parse(decodeURIComponent(match[1]));
  } catch (_) {
    return null;
  }
}

function applyKlaroConsent() {
  const consents = getKlaroConsent();
  if (!consents) return;
  updateGAConsent(consents["google-analytics"] === true);
}

export const onClientEntry = () => {
  // Apply stored consent immediately on page load
  applyKlaroConsent();

  // Listen for consent changes via Klaro's manager
  window.addEventListener("load", () => {
    if (window.klaro && window.klaro.getManager) {
      const manager = window.klaro.getManager();
      manager.watch({
        update(manager, eventType) {
          if (eventType === "saveConsents") {
            const granted = manager.getConsent("google-analytics");
            updateGAConsent(granted);
          }
        },
      });
    }
  });
};
