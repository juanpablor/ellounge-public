import React from "react";
import { graphql } from "gatsby";
import { useTranslation } from "react-i18next";
import LatinClubLayout from "./latinClubLayout";
import companyData from "../data/data.json";
import { CompanyData } from "../interfaces/interfaces";
import images from "../images/drinks/index";

// Importa tu JSON de productos (el que pegaste)
import menuData from "../data/drinks.json"; // Asumo que lo guardaste como menu.json
import Footer from "../components/footer";

const info: CompanyData = companyData[0];

const PriceList: React.FC = () => {
  const { t } = useTranslation();
  const companyInfo: CompanyData = companyData[0];

  const renderMenuSection = (title: string, items: { name: string; price: number; image?: string; note1?: string; extras?: string }[]) => (
    <div className="mb-16">
      <h2 className="text-2xl md:text-4xl font-bold text-center mb-10 text-terciary">{t(title)}</h2>
      <div className=" gap-10">
        {items.map((item, idx) => {
          const imageKey = item.image;
          const imageData = images[imageKey as keyof typeof images];

          return (
            <div key={idx} className="flex items-center w-full odd:bg-primary/60 even:bg-terciary/60">
              {imageData && (
                <div className="w-14 h-14 items-center justify-center flex m-2">
                  <img src={imageData.src} alt={imageData.alt || ""} className=" object-cover" />
                </div>
            )}
              <div className={`w-full ${!imageData ? "pl-2" : ""}`}>
                    <h3 className="text-secondary text-xl font-semibold">{item.name}</h3>
                <div className="flex justify-between w-full">
                    <p className="text-sm text-gray-300" dangerouslySetInnerHTML={{ __html: t(`drinks.${item.image}`) || "" }}></p>
                    <p className="text-secondary text-lg font-extrabold pr-2">{item.price}$</p>
                </div>
                {item.extras && (
                    <ul className="list-disc ml-5 mt-2 text-sm text-gray-300" dangerouslySetInnerHTML={{ __html: item.extras }} />
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );

  return (
    <LatinClubLayout
      data={companyInfo}
      seoTitle={`${t("productMenu.drinks_title")} | El Lounge Montréal`}
      seoDescription={t("content.content_third_block")}
    >

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        {renderMenuSection("productMenu.cocktailsSignature", menuData.cocktailsSignature.map(item => ({ ...item, price: parseFloat(item.price) })))}
        {renderMenuSection("productMenu.houseCocktails", menuData.houseCocktails.map(item => ({ ...item, price: parseFloat(item.price) })))}
        {renderMenuSection("productMenu.classicCocktails", menuData.classicCocktails.map(item => ({ ...item, price: parseFloat(item.price) })))}
        {renderMenuSection("productMenu.shots", menuData.shots.map(item => ({ ...item, price: parseFloat(item.price) })))}
        {renderMenuSection("productMenu.glass", menuData.glass.map(item => ({ ...item, price: parseFloat(item.price) })))}
        {renderMenuSection("productMenu.houseShots", menuData.houseShots.map(item => ({ ...item, price: parseFloat(item.price) })))}
        {renderMenuSection("productMenu.bottles", menuData.bottles.map(item => ({ ...item, price: parseFloat(item.price) })))}
        {renderMenuSection("productMenu.beer", menuData.beer.map(item => ({ ...item, price: parseFloat(item.price) })))}
        {renderMenuSection("productMenu.sangrias", menuData.sangrias.map(item => ({ ...item, price: parseFloat(item.price) })))}
        {renderMenuSection("productMenu.wine", menuData.wine.map(item => ({ ...item, price: parseFloat(item.price) })))}
        {renderMenuSection("productMenu.mocktails", menuData.mocktails.map(item => ({ ...item, price: parseFloat(item.price) })))}
        {renderMenuSection("productMenu.non_alcoholic", menuData.non_alcoholic.map(item => ({ ...item, price: parseFloat(item.price) })))}
      </div>

      <div className="flex bg-latinClub relative z-20">
        <Footer isLatinClub={false} data={info} />
      </div>
    </LatinClubLayout>
  );
};

export default PriceList;

export const query = graphql`
  query ($language: String!) {
    locales: allLocale(filter: { language: { eq: $language } }) {
      edges {
        node {
          ns
          data
          language
        }
      }
    }
  }
`;
