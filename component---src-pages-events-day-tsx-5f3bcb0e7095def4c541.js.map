import React from "react";
import { graphql } from "gatsby";
import MenuLayout from "./foodLayout";
import { CompanyData } from "../interfaces/interfaces";
import companyData from "../data/data.json";
import { useTranslation } from "react-i18next";
import Footer from "../components/footer";
import images from "../images/index";

const info: CompanyData = companyData[0];

const EventsDay: React.FC = () => {
  const companyInfo: CompanyData = companyData[0];
  const { t } = useTranslation();
  const white = "rgba(255, 255, 255, 0.5)";
  const secondary = "rgb(38, 77, 76)";
  const primary = "rgba(163, 175, 61, 0.75)";

  return (
    <MenuLayout
      data={companyInfo}
      seoTitle={`${t("menu.eventsDay")} | El Lounge Montréal`}
      seoDescription={t("events.title")}
    >


      {/* 🗓 Eventos */}
      <div className="w-4/5 mx-auto my-20">
        <h2 className="text-3xl text-center text-primary font-bold mb-10">
          {t("events.title")}
        </h2>
        <div className="flex flex-col gap-10">
          {companyInfo.events?.map((event, index) => {
            const imageKey = t(`events.${event.image}`);
            const imageData = images[imageKey as keyof typeof images];

            return (
              <div
                key={index}
                className="flex flex-col md:flex-row bg-white bg-opacity-10 backdrop-blur-md border border-white border-opacity-20 rounded-xl shadow-lg text-white overflow-hidden"
              >
                <div className="md:w-1/2">
                  <img
                    src={imageData?.src}
                    alt={imageData?.alt || ""}
                    className="w-full h-64 md:h-full object-cover"
                  />
                </div>

                <div className="p-6 flex flex-col justify-center md:w-1/2">
                  <h3 className="text-2xl font-semibold mb-2">
                    {t(`events.${event.name}`)}
                  </h3>
                  <p className="text-sm text-gray-200 mb-1">
                    {t(`events.${event.date}`)}
                  </p>
                  <p
                    className="mt-2"
                    dangerouslySetInnerHTML={{
                      __html: t(`events.${event.description}`) || "",
                    }}
                  ></p>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <div className="flex flex-col w-2/5 mx-auto !hidden">
        <h3 className="text-center text-primary text-4xl">Visítanos</h3>
        <p className="text-center text-white">
          Descubre lo mejor de la cocina colombiana y venezolana en Point Bar
          Lounge. Convenientemente ubicado en Montreal, te invitamos a unirte a
          nosotros para una experiencia gastronómica inolvidable que celebra los
          vibrantes sabores de América Latina. Desde nuestros cócteles
          innovadores hasta nuestros platos deliciosos, cada momento en Point
          Bar Lounge es una celebración de la excelencia culinaria
        </p>
      </div>


      {/* 📅 Reserva & Mapa */}
      <div className="mb-20">
        <div className="flex w-4/5 mx-auto h-[550px]">
          <iframe
            className="w-full iframe"
            style={{ color: "rgb(255, 255, 255) !important" }}
            src={`https://widgets.libroreserve.com/WEB/QC016493475991/book?bg-color=${primary}&bg-color-2=${secondary}&btn-color=${secondary}&btn-text-color=${primary}&text-color-2=${white}&text-color-3=${white}`}
          ></iframe>
        </div>

        <div className="flex justify-center mt-20">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d698.9297002212503!2d-73.564428!3d45.515739!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4cc91bb3584f533f%3A0xa4b0a3a9138e80a0!2s1735%20Saint%20Denis%20St%2C%20Montreal%2C%20QC%20H2X%203K4%2C%20Canada!5e0!3m2!1sen!2sus!4v1729733864453!5m2!1sen!2sus"
            width="600"
            height="450"
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <div className="flex bg-latinClub relative z-20">
        <Footer isLatinClub={false} data={info} />
      </div>
    </MenuLayout>
  );
};

export default EventsDay;

export const query = graphql`
  query ($language: String!) {
    locales: allLocale(filter: { language: { eq: $language } }) {
      edges {
        node {
          ns
          data
          language
        }
      }
    }
  }
`;
